# HydraDB connection
HYDRADB_BOLT_URI=neo4j://127.0.0.1:7687
HYDRADB_HTTP_URI=http://127.0.0.1:8443
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes

# LLM providers — see BUILD-SPEC.md §16. Both required for the dual-worker pattern.
# Free tier only — do not enable billing on either account (removes free-tier access).
GEMINI_API_KEY=
GROQ_API_KEY=

# Corpus location. The full EnterpriseRAG-Bench corpus is already vendored locally in
# this dev environment (see PROJECT.md decision #9) — point CORPUS_DIR straight at it
# rather than downloading/unzipping release slices.
CORPUS_DIR=./vendor/EnterpriseRAG-Bench/generated_data/sources

# Ingest tuning
INGEST_BATCH_SIZE=500
# Recalibrated from the spec's 0.08 default against the full 511,958-doc corpus
# (see PROJECT.md decision #11) — set to the real value once M2 computes it.
TIER2_SAMPLE_FRACTION=0.01

# Eval
EVAL_CONSISTENCY_MODE=strong
